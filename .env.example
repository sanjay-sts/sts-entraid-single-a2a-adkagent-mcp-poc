# Auth Bypass for Development
# To bypass auth for MCP/A2A Inspector testing, copy
# dev_config.example.toml to dev_config.toml and set disable_auth = true.

# Microsoft Entra ID Configuration
# Get these from Azure Portal > App registrations
ENTRA_CLIENT_ID=your-app-registration-client-id
ENTRA_TENANT_ID=your-directory-tenant-id

# Client secret for OBO (On-Behalf-Of) token exchange with Graph API.
# Required for Graph tools (get_user_profile, list_files, send_email) to
# exchange the custom-audience token for a Graph-scoped token.
# Azure Portal > App registrations > Certificates & secrets > New client secret
# Without this, Graph tools fall back to token claims / error responses.
ENTRA_CLIENT_SECRET=your-client-secret

# Access Control Group IDs (used by A2A server for agent-level access control)
# Create security groups in Entra ID and copy their Object IDs
ADMIN_GROUP_ID=your-admin-group-object-id
DEVELOPER_GROUP_ID=your-developer-group-object-id
VIEWER_GROUP_ID=your-viewer-group-object-id

# MCP Server Permissions
# The MCP server uses permissions.toml for tool-level RBAC (group-to-role mapping).
# Copy permissions.example.toml to permissions.toml and configure your group GUIDs.
# See permissions.example.toml for format and options.

# Blocked Users (comma-separated user object IDs)
BLOCKED_USERS=

# Server Ports
A2A_SERVER_PORT=10000
ADK_SERVER_PORT=10001
MCP_SERVER_PORT=10002
FRONTEND_PORT=10003

# AWS Bedrock (for Claude Haiku via LiteLLM)
# Model: global.anthropic.claude-haiku-4-5-20251001-v1:0
# 12-hour bearer token — regenerate before expiry
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token
AWS_REGION_NAME=us-east-1

# =============================================================================
# AWS Cognito (Second IdP)
# =============================================================================
# Cognito User Pool for multi-IdP testing
# Create in AWS Console > Cognito > User Pools
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_REGION=us-east-1

# Cognito group names (used by A2A server for agent-level access control)
COGNITO_ADMIN_GROUP=platform-admins
COGNITO_DEVELOPER_GROUP=platform-developers
COGNITO_VIEWER_GROUP=platform-viewers

# =============================================================================
# AWS S3 (for S3 tools — server-side credentials)
# =============================================================================
# IAM user/role with s3:ListBucket, s3:ListAllMyBuckets, s3:GetObject, s3:HeadObject
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# =============================================================================
# Test Tokens (for pytest security dashboard tests)
# =============================================================================
# Pre-acquired real Entra ID tokens for automated testing.
# Tests skip gracefully when tokens are not set.
#
# How to acquire tokens:
#   1. Start frontend at http://localhost:10003
#   2. Sign in as each test user, select "destructive" scope preset
#   3. Open Token Inspector in sidebar -> copy the raw token
#   4. Paste below as the corresponding TEST_*_TOKEN
#
# Tokens expire after ~1 hour. Re-acquire before each test session.
#
# Test Users:
#   Admin:     AdeleV@2tdgcb.onmicrosoft.com   (AI-Agent-Admins group)
#   Developer: DiegoS@2tdgcb.onmicrosoft.com   (AI-Agent-Developers group)
#   Viewer:    JohannaL@2tdgcb.onmicrosoft.com (AI-Agent-Viewers group)
#   No-group:  User not in any of the 3 groups
TEST_ADMIN_TOKEN=
TEST_DEVELOPER_TOKEN=
TEST_VIEWER_TOKEN=
TEST_NOGROUP_TOKEN=

# =============================================================================
# Agent Identities (multi-agent authn/z — see docs/ENTRA_AGENT_SETUP.md)
# =============================================================================
# One Entra app registration per agent, each authenticating with an x509
# certificate from pki/certs/. The gateway reuses ENTRA_CLIENT_ID above.
AGENT_ORCHESTRATOR_CLIENT_ID=
AGENT_PEER_CLIENT_ID=
AGENT_EVENT_TRIGGER_CLIENT_ID=

# Directory holding the generated key pairs (pki/generate_certs.py)
AGENT_CERT_DIR=pki/certs

# App role a caller must hold to invoke an agent
AGENT_REQUIRED_ROLE=Agent.Invoke

# Ports for the new agents
ORCHESTRATOR_PORT=10004
PEER_AGENT_PORT=10005
